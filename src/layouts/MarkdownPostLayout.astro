---
import BaseLayout from "./BaseLayout.astro";
const { frontmatter } = Astro.props;
---

<BaseLayout pageTitle={frontmatter.title}>
    <p class="description"><em>{frontmatter.description}</em></p>
    <slot />
</BaseLayout>

<style>
  .description {
    font-size: clamp(1.5rem, 2.5vw, 1.5rem);
    margin-bottom: 2rem;
  }
</style>

