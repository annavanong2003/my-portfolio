---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const recipes = await getCollection("recipes");

  return recipes.map((recipe) => ({
    params: { id: recipe.id.toString() },
    props: {
      recipe,
    },
  }));
}

const { id } = Astro.params;
const { recipe } = Astro.props;
const { Content } = await render(recipe);
---

<BaseLayout pageTitle="">
  <a href={`${import.meta.env.BASE_URL}recipes`} class="back-button"
    >← Back to Recipes</a
  >
  <h1 class="post-title">{recipe.data.title}</h1>
  <p class="description">{recipe.data.description}</p>
  <Content />
</BaseLayout>

<style>
  .back-button {
    display: inline-block;
    font-family: "Aesthetic";
    font-size: 1.5rem;
    text-transform: uppercase;
    background-color: rgb(166, 1, 59);
    color: white;
    padding: 0.7rem 1rem;
    border-radius: 2rem;
    text-decoration: none;
    text-align: center;
    font-weight: 600;
    margin-bottom: 2rem;
    transition:
      transform 0.15s ease,
      opacity 0.15s ease;
  }

  .back-button:hover {
    transform: translateY(-0.2rem);
    opacity: 0.8;
  }

  html.dark .back-button {
    background-color: #f9f6f1;
    color: rgb(28, 0, 10);
  }

  html.dark .back-button:hover {
    background-color: #f9f6f1;
    color: rgb(28, 0, 10);
    opacity: 0.8;
  }

  .post-title {
    font-family: "Aesthetic" !important;
    font-size: clamp(5rem, 10vw, 10rem) !important;
    margin: 1rem 0 !important;
    text-transform: uppercase !important;
  }

  .description {
    font-size: clamp(1.5rem, 2.5vw, 1.5rem);
    margin-bottom: 2rem;
  }
</style>
