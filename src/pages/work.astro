---
import BaseLayout from "../layouts/BaseLayout.astro";
const pageTitle = "My work";
---

<BaseLayout pageTitle={pageTitle}>
  <p style="font-size: clamp(1.65rem, 2.75vw, 1.65rem); line-height: 1.4;">
    Here you can find my previous projects
  </p>
  <ul class="work-grid">
    <li class="work-card">
      <a href={`${import.meta.env.BASE_URL}projects`} class="work-link"
        >Projects</a
      >
    </li>
  </ul>
</BaseLayout>

<style>
  .work-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: 1.5rem;
    padding: 0;
    list-style: none;
    margin-top: 2rem;
  }

  .work-card {
    list-style: none;
  }

  .work-link {
    font-family: "Aesthetic";
    font-size: 2rem;
    display: block;
    background-color: rgb(166, 1, 59);
    color: white;
    padding: 0.9rem 1.2rem;
    border-radius: 2rem;
    text-decoration: none;
    text-align: center;
    font-weight: 600;
    transition:
      transform 0.15s ease,
      opacity 0.15s ease;
  }

  .work-link:hover {
    transform: translateY(-0.2rem);
    opacity: 0.8;
  }

  html.dark .work-link {
    background-color: #f9f6f1;
    color: rgb(28, 0, 10);
  }

  html.dark .work-link:hover {
    background-color: #f9f6f1;
    color: rgb(28, 0, 10);
    opacity: 0.8;
  }
</style>
