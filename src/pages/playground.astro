---
import BaseLayout from "../layouts/BaseLayout.astro";
const pageTitle = "Playground";
---

<BaseLayout pageTitle={pageTitle}>
  <p style="font-size: clamp(1.65rem, 2.75vw, 1.65rem); line-height: 1.4;">
    A space for experiments, sketches, and creative explorations.
  </p>
  <ul class="playground-grid">
    <li class="playground-card">
      <a href={`${import.meta.env.BASE_URL}recipes`} class="playground-link"
        >Recipes</a
      >
    </li>
    <li class="playground-card">
      <a
        href={`${import.meta.env.BASE_URL}illustrations`}
        class="playground-link">Illustrations</a
      >
    </li>
    <li class="playground-card">
      <a href={`${import.meta.env.BASE_URL}photography`} class="playground-link"
        >Photography</a
      >
    </li>
  </ul>
</BaseLayout>

<style>
  .playground-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: 1.5rem;
    padding: 0;
    list-style: none;
    margin-top: 2rem;
  }

  .playground-card {
    list-style: none;
  }

  .playground-link {
    font-family: "Aesthetic";
    font-size: 2rem;
    display: block;
    background-color: rgb(166, 1, 59);
    color: white;
    padding: 0.9rem 1.2rem;
    border-radius: 2rem;
    text-decoration: none;
    text-align: center;
    font-weight: 600;
    transition:
      transform 0.15s ease,
      opacity 0.15s ease;
  }

  .playground-link:hover {
    transform: translateY(-0.2rem);
    opacity: 0.8;
  }

  html.dark .playground-link {
    background-color: #f9f6f1;
    color: rgb(28, 0, 10);
  }

  html.dark .playground-link:hover {
    background-color: #f9f6f1;
    color: rgb(28, 0, 10);
    opacity: 0.8;
  }
</style>
