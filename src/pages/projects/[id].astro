---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection, render } from "astro:content";
import catImage from "../../assets/images/cat.jpg";
import { Image } from "astro:assets";

export async function getStaticPaths() {
  const projects = await getCollection("projects");

  return projects.map((project) => ({
    params: { id: project.id.toString() },
    props: {
      project,
    },
  }));
}

const { id } = Astro.params;
const { project } = Astro.props;
const { Content } = await render(project);
---

<BaseLayout pageTitle="">
  <a href={`${import.meta.env.BASE_URL}projects`} class="back-button"
    >← Back to Projects</a
  >
  <h1 class="post-title">{project.data.title}</h1>
  <p class="description">{project.data.description}</p>
  <Content />

  <div class="gallery">
    <Image src={catImage} alt={project.data.title} class="gallery-image" />
  </div>
</BaseLayout>

<style>
  .back-button {
    display: inline-block;
    font-family: "Aesthetic";
    font-size: 1.5rem;
    background-color: rgb(166, 1, 59);
    color: white;
    padding: 0.7rem 1rem;
    border-radius: 2rem;
    text-decoration: none;
    text-align: center;
    font-weight: 600;
    margin-bottom: 2rem;
    transition:
      transform 0.15s ease,
      opacity 0.15s ease;
  }

  .back-button:hover {
    transform: translateY(-0.2rem);
    opacity: 0.8;
  }

  html.dark .back-button {
    background-color: #f9f6f1;
    color: rgb(28, 0, 10);
  }

  html.dark .back-button:hover {
    background-color: #f9f6f1;
    color: rgb(28, 0, 10);
    opacity: 0.8;
  }

  .post-title {
    font-family: "Aesthetic" !important;
    font-size: clamp(4rem, 8vw, 8rem) !important;
    margin: 1rem 0 !important;
    line-height: 0.9 !important;
  }

  .description {
    font-size: clamp(1.65rem, 2.75vw, 1.65rem);
    margin-bottom: 2rem;
    line-height: 1.6;
  }

  .gallery {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: 1.5rem;
    margin-top: 3rem;
    padding-top: 3rem;
    border-top: 0.125rem solid rgb(166, 1, 59);
  }

  @media (max-width: 40.625rem) {
    .gallery {
      grid-template-columns: 1fr;
    }
  }

  .gallery-image {
    width: 100%;
    height: auto;
    border-radius: 1rem;
  }

  html.dark .gallery {
    border-top-color: #f9f6f1;
  }
</style>
