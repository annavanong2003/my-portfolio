---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection, render } from "astro:content";
import catImage from "../../assets/images/cat.jpg";
import { Image } from "astro:assets";

export async function getStaticPaths() {
  const projects = await getCollection("projects");

  return projects.map((project) => ({
    params: { id: project.id.toString() },
    props: {
      project,
    },
  }));
}

const { id } = Astro.params;
const { project } = Astro.props;
const { Content } = await render(project);
---

<BaseLayout pageTitle="">
  <a href={`${import.meta.env.BASE_URL}projects`} class="back-button"
    >← Back to Projects</a
  >
  <h1 class="post-title">{project.data.title}</h1>
  <div class="content-wrapper">
    <Image src={catImage} alt={project.data.title} class="project-image" />
    <div class="text-content">
      <p class="description">{project.data.description}</p>
      <Content />
    </div>
  </div>
</BaseLayout>

<style>
  .back-button {
    display: inline-block;
    font-family: "Aesthetic";
    font-size: 1.5rem;
    text-transform: uppercase;
    background-color: rgb(166, 1, 59);
    color: white;
    padding: 0.7rem 1rem;
    border-radius: 2rem;
    text-decoration: none;
    text-align: center;
    font-weight: 600;
    margin-bottom: 2rem;
    transition:
      transform 0.15s ease,
      opacity 0.15s ease;
  }

  .back-button:hover {
    transform: translateY(-0.2rem);
    opacity: 0.8;
  }

  html.dark .back-button {
    background-color: #f9f6f1;
    color: rgb(28, 0, 10);
  }

  html.dark .back-button:hover {
    background-color: #f9f6f1;
    color: rgb(28, 0, 10);
    opacity: 0.8;
  }

  .post-title {
    font-family: "Aesthetic" !important;
    font-size: clamp(4rem, 8vw, 8rem) !important;
    margin: 1rem 0 !important;
    text-transform: uppercase !important;
    line-height: 0.9 !important;
  }

  .description {
    font-size: clamp(1.5rem, 2.5vw, 1.5rem);
    margin-bottom: 2rem;
  }

  .content-wrapper {
    display: flex;
    gap: 2rem;
    align-items: flex-start;
  }

  @media (max-width: 40.625rem) {
    .content-wrapper {
      flex-direction: column;
    }
  }

  .project-image {
    width: 100%;
    max-width: 20rem;
    height: auto;
    border-radius: 1rem;
    flex-shrink: 0;
  }

  .text-content {
    flex: 1;
  }
</style>
