---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import type { GetStaticPaths, Page } from "astro";
import type { CollectionEntry } from "astro:content";

export const getStaticPaths = (async ({ paginate }) => {
  const projects = await getCollection("projects");
  return paginate(projects, { pageSize: 25 });
}) satisfies GetStaticPaths;

interface Props {
  page: Page<CollectionEntry<"projects">>;
}

const { page } = Astro.props;
const pageTitle = "Projects";
---

<BaseLayout pageTitle={pageTitle}>
  <p>Here you can find my previous projects I worked on</p>
  <ul class="projects-grid">
    {
      page.data.map((project) => (
        <li class="project-card">
          <a
            href={`${import.meta.env.BASE_URL}projects/${project.id}`}
            class="project-link"
          >
            {project.data.title}
          </a>
        </li>
      ))
    }
  </ul>
  
  {page.lastPage > 1 && (
    <nav class="pagination">
      {page.url.prev && (
        <a href={page.url.prev} class="pagination-link">← Previous</a>
      )}
      <span class="pagination-info">
        Page {page.currentPage} of {page.lastPage}
      </span>
      {page.url.next && (
        <a href={page.url.next} class="pagination-link">Next →</a>
      )}
    </nav>
  )}
</BaseLayout>

<style>
  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: 1.5rem;
    padding: 0;
    list-style: none;
    margin-top: 2rem;
  }

  .project-card {
    list-style: none;
  }

  .project-link {
    font-family: "Aesthetic";
    font-size: 2rem;
    text-transform: uppercase;
    display: block;
    background-color: rgb(166, 1, 59);
    color: white;
    padding: 0.9rem 1.2rem;
    border-radius: 2rem;
    text-decoration: none;
    text-align: center;
    font-weight: 600;
    transition:
      transform 0.15s ease,
      opacity 0.15s ease;
  }

  .project-link:hover {
    transform: translateY(-0.2rem);
    opacity: 0.8;
  }

  html.dark .project-link {
    background-color: #f9f6f1;
    color: rgb(28, 0, 10);
  }

  html.dark .project-link:hover {
    background-color: #f9f6f1;
    color: rgb(28, 0, 10);
    opacity: 0.8;
  }

  .pagination {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 2rem;
    margin-top: 3rem;
  }

  .pagination-link {
    display: inline-block;
    font-family: "Aesthetic";
    font-size: 1.2rem;
    text-transform: uppercase;
    background-color: rgb(166, 1, 59);
    color: white;
    padding: 0.6rem 0.9rem;
    border-radius: 2rem;
    text-decoration: none;
    text-align: center;
    font-weight: 600;
    transition:
      transform 0.15s ease,
      opacity 0.15s ease;
  }

  .pagination-link:hover {
    transform: translateY(-0.2rem);
    opacity: 0.8;
  }

  .pagination-info {
    font-family: "DarkerGrotesque";
    font-size: 1.2rem;
  }

  html.dark .pagination-link {
    background-color: #f9f6f1;
    color: rgb(28, 0, 10);
  }

  html.dark .pagination-link:hover {
    background-color: #f9f6f1;
    color: rgb(28, 0, 10);
    opacity: 0.8;
  }
</style>
