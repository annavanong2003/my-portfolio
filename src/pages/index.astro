---
import Layout from "../layouts/BaseLayout.astro";
const pageTitle = "Portfolio";
---

<Layout pageTitle={pageTitle}>
  <p>Hello! I'm Anna.</p>
  This portfolio gathers my latest projects
</Layout> alongside my favourite illustrations. Take a look around and enjoy the
mix.

<style>
  h1 {
    font-size: clamp(5rem, 10vw, 10rem) !important;
  }

  p {
    font-size: clamp(1.65rem, 2.75vw, 1.65rem);
    line-height: 1.6;
  }
</style>
