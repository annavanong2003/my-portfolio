---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import catImage from "../assets/images/cat.jpg";
import autumnSaladImage from "../assets/images/recipes/Autumn salad.png";
import chickenImage from "../assets/images/recipes/chicken.png";
import cookiesImage from "../assets/images/recipes/chocolatechicpcookies.png";
import bananaImage from "../assets/images/recipes/Banana.png";
import ResponsiveImage from "../components/ResponsiveImage.astro";

const pageTitle = "Recipes";
const recipes = await getCollection("recipes");
---

<BaseLayout pageTitle={pageTitle}>
  <p style="font-size: clamp(1.65rem, 2.75vw, 1.65rem); line-height: 1.4;">
    Explore my favorite recipes and culinary experiments
    <a
      href={`${import.meta.env.BASE_URL}recipes/rss.xml`}
      class="rss-link"
      aria-label="Subscribe to recipes RSS feed"
    >
      📡 RSS
    </a>
  </p>
  <ul class="recipes-grid">
    {
      recipes.map((recipe) => (
        <li class="recipe-card">
          <a
            href={`${import.meta.env.BASE_URL}recipes/${recipe.id}`}
            class="recipe-link"
          >
            <ResponsiveImage
              src={
                recipe.id === "autumn-salad"
                  ? autumnSaladImage
                  : recipe.id === "cashew-chicken"
                    ? chickenImage
                    : recipe.id === "chocolate-chip-cookies"
                      ? cookiesImage
                      : recipe.id === "banana-bread"
                        ? bananaImage
                        : catImage
              }
              alt={recipe.data.title}
              class="recipe-image"
              loading="lazy"
              sizes="(min-width: 66em) 25vw, (min-width: 44em) 33vw, 50vw"
              width={800}
              height={600}
            />
            <span class="recipe-title">{recipe.data.title}</span>
          </a>
        </li>
      ))
    }
  </ul>
  <div class="navigation-buttons">
    <a href={`${import.meta.env.BASE_URL}illustrations`} class="nav-link"
      >← Illustrations</a
    >
    <a href={`${import.meta.env.BASE_URL}photography`} class="nav-link"
      >Photography →</a
    >
  </div>
</BaseLayout>

<style>
  .rss-link {
    display: inline-block;
    margin-left: 1rem;
    padding: 0.25rem 0.75rem;
    background-color: rgb(166, 1, 59);
    color: white;
    text-decoration: none;
    border-radius: 0.5rem;
    font-size: 0.9rem;
    transition: opacity 0.15s ease;
  }

  .rss-link:hover {
    opacity: 0.8;
  }

  html.dark .rss-link {
    background-color: #f9f6f1;
    color: rgb(28, 0, 10);
  }

  .recipes-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: 1.5rem;
    padding: 0;
    list-style: none;
    margin-top: 2rem;
  }

  @media (max-width: 40.625rem) {
    .recipes-grid {
      grid-template-columns: 1fr;
    }
  }

  .recipe-card {
    list-style: none;
  }

  .recipe-link {
    font-family: "Aesthetic";
    font-size: 1.5rem;
    display: flex;
    flex-direction: column;
    background-color: white;
    color: rgb(166, 1, 59);
    border-radius: 1rem;
    text-decoration: none;
    text-align: center;
    font-weight: 600;
    overflow: hidden;
    box-shadow: 0 0.25rem 0.5rem rgba(0, 0, 0, 0.1);
    transition:
      transform 0.15s ease,
      box-shadow 0.15s ease;
  }

  .recipe-image {
    width: 100%;
    height: 15rem;
    object-fit: cover;
  }

  .recipe-title {
    display: block;
    padding: 1.2rem;
    background-color: rgb(166, 1, 59);
    color: white;
  }

  .recipe-link:hover {
    transform: translateY(-0.3rem);
    box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15);
  }

  html.dark .recipe-link {
    background-color: rgb(28, 0, 10);
    color: #f9f6f1;
  }

  html.dark .recipe-title {
    background-color: #f9f6f1;
    color: rgb(28, 0, 10);
  }

  html.dark .recipe-link:hover {
    box-shadow: 0 0.5rem 1rem rgba(255, 255, 255, 0.1);
  }

  .navigation-buttons {
    margin-top: 3rem;
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .nav-link {
    display: inline-block;
    font-family: "Aesthetic";
    font-size: 1.2rem;
    background-color: rgb(166, 1, 59);
    color: white;
    padding: 0.6rem 0.9rem;
    border-radius: 2rem;
    text-decoration: none;
    text-align: center;
    font-weight: 600;
    transition:
      transform 0.15s ease,
      opacity 0.15s ease;
  }

  .nav-link:hover {
    transform: translateY(-0.2rem);
    opacity: 0.8;
  }

  html.dark .nav-link {
    background-color: #f9f6f1;
    color: rgb(28, 0, 10);
  }

  html.dark .nav-link:hover {
    background-color: #f9f6f1;
    color: rgb(28, 0, 10);
    opacity: 0.8;
  }
</style>
