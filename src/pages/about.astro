---
import BaseLayout from "../layouts/BaseLayout.astro";
import catImage from "../assets/images/cat.jpg";
import { Image } from "astro:assets";
const pageTitle = "About";
---

<BaseLayout pageTitle={pageTitle}>
  <div class="about-content">
    <Image src={catImage} alt="About me" class="about-image" />
    <p>Learn more about me and my creative journey.</p>
  </div>
</BaseLayout>

<style>
  .about-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2rem;
  }

  .about-image {
    width: 100%;
    max-width: 40rem;
    height: auto;
    border-radius: 1rem;
    margin: 2rem 0;
  }

  p {
    font-size: clamp(1.65rem, 2.75vw, 1.65rem);
    text-align: center;
    line-height: 1.6;
  }
</style>
