---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import catImage from "../assets/images/cat.jpg";
import { Image } from "astro:assets";
const pageTitle = "About";
const skills = await getCollection("skills");
---

<BaseLayout pageTitle={pageTitle}>
  <div class="about-content">
    <Image src={catImage} alt="About me" class="about-image" />
    <p>Learn more about me and my creative journey.</p>

    <h2>Skills & Tools</h2>
    <ul class="skills-grid">
      {
        skills.map((skill) => (
          <li class="skill-card">
            <span class="skill-icon">{skill.data.icon}</span>
            <h3>{skill.data.name}</h3>
            <p class="skill-category">{skill.data.category}</p>
            <p class="skill-level">{skill.data.level}</p>
          </li>
        ))
      }
    </ul>
  </div>
</BaseLayout>

<style>
  .about-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2rem;
  }

  .about-image {
    width: 100%;
    max-width: 40rem;
    height: auto;
    border-radius: 1rem;
    margin: 2rem 0;
  }

  p {
    font-size: clamp(1.65rem, 2.75vw, 1.65rem);
    text-align: center;
    line-height: 1.4;
  }

  h2 {
    font-family: "Aesthetic";
    font-size: clamp(2rem, 4vw, 3rem);
    text-align: center;
    margin: 3rem 0 2rem 0;
  }

  .skills-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    padding: 0;
    list-style: none;
    margin-top: 2rem;
  }

  @media (max-width: 40.625rem) {
    .skills-grid {
      grid-template-columns: 1fr;
    }
  }

  .skill-card {
    list-style: none;
    background-color: white;
    padding: 2rem;
    border-radius: 1rem;
    text-align: center;
    box-shadow: 0 0.25rem 0.5rem rgba(0, 0, 0, 0.1);
    transition:
      transform 0.15s ease,
      box-shadow 0.15s ease;
  }

  .skill-card:hover {
    transform: translateY(-0.3rem);
    box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15);
  }

  .skill-icon {
    font-size: 3rem;
    display: block;
    margin-bottom: 1rem;
  }

  .skill-card h3 {
    font-family: "Aesthetic";
    font-size: 1.8rem;
    margin: 0.5rem 0;
    color: rgb(166, 1, 59);
  }

  .skill-category {
    font-size: 1.2rem;
    color: #666;
    margin: 0.3rem 0;
  }

  .skill-level {
    font-size: 1rem;
    font-weight: 600;
    color: rgb(166, 1, 59);
    margin-top: 0.5rem;
  }

  html.dark .skill-card {
    background-color: rgb(28, 0, 10);
  }

  html.dark .skill-card h3 {
    color: #f9f6f1;
  }

  html.dark .skill-category {
    color: #ccc;
  }

  html.dark .skill-level {
    color: #f9f6f1;
  }

  html.dark .skill-card:hover {
    box-shadow: 0 0.5rem 1rem rgba(255, 255, 255, 0.1);
  }
</style>
