<div id="main-menu" class="nav-links">
  <a href={`${import.meta.env.BASE_URL}`}>Home</a>
  <a href={`${import.meta.env.BASE_URL}work`}>My work</a>
</div>

<style>
	.nav-links {
		width: 100%;
		display: none;
		margin: 0;
		border-radius: 2rem;
	}

	.nav-links a {
		display: block;
		text-align: center;
		padding: 0.9rem 1.2rem;
		text-decoration: none;
		font-family: "Aesthetic";
		font-size: 2rem;
		text-transform: uppercase;
		color: rgb(166, 1, 59);
		border-radius: 2rem;
	}

	.nav-links a:hover,
	.nav-links a:focus {
		background-color: rgb(166, 1, 59);
		color: #f9f6f1;
		border-radius: 2rem;
	}

	:has(.menu[aria-expanded="true"]) .nav-links {
		display: unset;
	}

	html.dark .nav-links a:hover,
	html.dark .nav-links a:focus {
		color: rgb(166, 1, 59);
		background-color: #f9f6f1;
		border-radius: 2rem;
	}

	html.dark .nav-links a {
		color: #f9f6f1;
		border-radius: 2rem;
	}

	@media screen and (min-width: 496px) {
		.nav-links {
			margin-left: 5em;
			display: block;
			position: static;
			width: auto;
			background: none;
		}

		.nav-links a {
			display: inline-block;
			padding: 0.9rem 1.2rem;
		}
	}
</style>
