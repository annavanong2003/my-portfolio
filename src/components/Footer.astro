---
import Social from "./Social.astro";
---

<style>
  footer {
    display: flex;
    flex-direction: column;
    margin-top: 2rem;
  }

  h2 {
    font-family: "Aesthetic";
    font-size: clamp(2.5rem, 8vw, 2.5rem);
    margin-top: 2rem;
    margin-bottom: 0;
  }

  .footer-links {
    display: flex;
    gap: 0.75rem;
    justify-content: center;
    flex-wrap: wrap;
    margin-top: 1.5rem;
  }

  footer p {
    font-size: 1.5em;
    margin: 0;
  }
</style>

<footer>
  <h2>Get in touch</h2>
  <p>Email: anna.van.ongeval@outlook.be</p>
  <div class="footer-links">
    <Social platform="Github" username="annavanong2003" />
    <Social platform="Behance" username="annavanongeval1" />
    <Social platform="Instagram" username="anna_vanong" />
  </div>
</footer>
