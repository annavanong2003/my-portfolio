---
const { platform, username } = Astro.props;
---

<a
  href={`https://www.${platform}.com/${username}`}
  target="_blank"
  rel="noopener noreferrer"
>
  {platform}
</a>

<style>
    a {
        font-family: "Aesthetic";
        font-size: 1.25rem;
        padding: 1rem 1rem;
        margin: 1rem;
        color: #f9f6f1;
        background-color: rgb(166, 1, 59);
        text-decoration: none;
        border-radius: 2rem;
    }

    a:hover {
        background-color: #f9f6f1;
        color: rgb(166, 1, 59);
        font-weight: bold;
        border-radius: 2rem;
    }
</style>
