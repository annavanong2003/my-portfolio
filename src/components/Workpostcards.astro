---
import { getCollection } from "astro:content";

const posts = await getCollection("posts");
---

{
  posts.map((post) => (
    <li class="post-card">
      <a href={`${import.meta.env.BASE_URL}posts/${post.id}`} class="post-link">{post.data.title}</a>
    </li>
  ))
}

<style>
  .post-card {
    list-style: none;
  }

  .post-link {
    font-family: "Aesthetic";
    font-size: 2rem;
    text-transform: uppercase;
    display: block;
    background-color: rgb(166, 1, 59);
    color: white;
    padding: 0.9rem 1.2rem;
    border-radius: 2rem;
    text-decoration: none;
    text-align: center;
    font-weight: 600;
    transition:
      transform 0.15s ease,
      opacity 0.15s ease;
  }

  .post-link:hover {
    transform: translateY(-0.2rem);
    opacity: 0.8;
  }

  html.dark .post-link {
    background-color: #f9f6f1;
    color: rgb(28, 0, 10);
  }

  html.dark .post-link:hover {
    background-color: #f9f6f1;
    color: rgb(28, 0, 10);
    opacity: 0.8;
  }
</style>
