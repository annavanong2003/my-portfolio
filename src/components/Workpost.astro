---
import Workpostcards from "./Workpostcards.astro";
---

<ul class="projects-grid">
  <Workpostcards />
</ul>

<style>
  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: 1.5rem;
    padding: 0;
    list-style: none;
    margin-top: 2rem;
  }

  .project-card {
    list-style: none;
  }

  .project-link {
    font-family: "Aesthetic";
    font-size: 2rem;
    text-transform: uppercase;
    display: block;
    background-color: rgb(166, 1, 59);
    color: white;
    padding: 0.9rem 1.2rem;
    border-radius: 2rem;
    text-decoration: none;
    text-align: center;
    font-weight: 600;
    transition:
      transform 0.15s ease,
      opacity 0.15s ease;
  }

  .project-link:hover {
    transform: translateY(-0.2rem);
    opacity: 0.8;
  }

  html.dark .project-link {
    background-color: #f9f6f1;
    color: rgb(28, 0, 10);
  }

  html.dark .project-link:hover {
    background-color: #f9f6f1;
    color: rgb(28, 0, 10);
    opacity: 0.8;
  }
</style>
