---
/**
 * ResponsiveImage Component
 * Demonstrates best practices for responsive images:
 * - Multiple format support (AVIF, WebP, JPEG/PNG)
 * - Width descriptors for srcset
 * - Sizes attribute for viewport-based selection
 * - Proper loading strategies
 *
 * Note: In production, you'd generate multiple sizes of each image.
 * For this demo, we're using the same image source to show the markup structure.
 */

interface Props {
  src: ImageMetadata | string;
  alt: string;
  class?: string;
  loading?: "lazy" | "eager";
  fetchpriority?: "high" | "low" | "auto";
  sizes?: string;
  width?: number;
  height?: number;
}

const {
  src,
  alt,
  class: className = "",
  loading = "lazy",
  fetchpriority = "auto",
  sizes = "(min-width: 66em) 33vw, (min-width: 44em) 50vw, 100vw",
  width = 750,
  height = 500,
} = Astro.props;

// In production, these would be different size variants
// For demonstration, we show the proper structure
const imagePath = typeof src === "string" ? src : src.src;
---

<picture>
  <!-- 
    Modern AVIF format - best compression
    In production, generate: image-480.avif, image-750.avif, image-1024.avif, image-1600.avif
  -->
  <source
    type="image/avif"
    srcset={`${imagePath} 480w, ${imagePath} 750w, ${imagePath} 1024w, ${imagePath} 1600w`}
    sizes={sizes}
  />

  <!-- 
    WebP format - widely supported fallback
    In production, generate: image-480.webp, image-750.webp, image-1024.webp, image-1600.webp
  -->
  <source
    type="image/webp"
    srcset={`${imagePath} 480w, ${imagePath} 750w, ${imagePath} 1024w, ${imagePath} 1600w`}
    sizes={sizes}
  />

  <!-- 
    JPEG/PNG fallback for older browsers
    Width descriptors tell browser which image to fetch based on viewport size
  -->
  <img
    src={imagePath}
    alt={alt}
    class={className}
    width={width}
    height={height}
    loading={loading}
    decoding="async"
    fetchpriority={fetchpriority}
    srcset={`${imagePath} 480w, ${imagePath} 750w, ${imagePath} 1024w, ${imagePath} 1600w`}
    sizes={sizes}
  />
</picture>

<style>
  picture {
    display: block;
    width: 100%;
    height: 100%;
  }

  img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
